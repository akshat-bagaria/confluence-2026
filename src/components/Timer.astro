<script>
  const eventDate = new Date("2026-10-25T08:30:00+05:30").getTime();

  function updateTimer() {
    const difference = Math.floor((eventDate - Date.now()) / 1000);
    const sign = difference < 0 ? "-" : "";
    const totalSeconds = Math.abs(difference);
    const units = {
      days: Math.floor(totalSeconds / 86_400),
      hours: Math.floor((totalSeconds % 86_400) / 3_600),
      minutes: Math.floor((totalSeconds % 3_600) / 60),
      seconds: totalSeconds % 60,
    };

    for (const [unit, value] of Object.entries(units)) {
      const element = document.getElementById(`timer-${unit}`);
      if (element) element.textContent = `${sign}${String(value).padStart(2, "0")}`;
    }

    const label = document.getElementById("timer-label");
    if (label) {
      label.textContent = difference < 0 ? "Time since event started" : "Event starts in";
    }
  }

  updateTimer();
  setInterval(updateTimer, 1000);
</script>

<div class="mt-8">
    <p id="timer-label" class="mb-3 text-sm uppercase tracking-[0.25em] text-emerald-300">
        Event starts in
    </p>

    <div class="flex w-full max-w-96 gap-2 text-center sm:gap-3">
        {
            ["days", "hours", "minutes", "seconds"].map((unit) => (
                <div class="min-w-0 flex-1 rounded-lg border border-emerald-400/30 bg-black/40 px-2 py-3 backdrop-blur sm:min-w-16 sm:px-3">
                    <span
                        id={`timer-${unit}`}
                        class="block text-xl font-bold text-lime-300 sm:text-2xl"
                    >
                        00
                    </span>
                    <span class="text-[0.65rem] uppercase text-gray-300 sm:text-xs">{unit}</span>
                </div>
            ))
        }
    </div>
</div>