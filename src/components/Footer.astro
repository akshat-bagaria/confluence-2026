---
const year = new Date().getFullYear();

const socials = [
  { name: "Instagram", href: "https://www.instagram.com/ieee.cs.pesu/", icon: "instagram" },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/ieeecspesu/home/", icon: "linkedin" },
  { name: "Email", href: "mailto:contact@ieeecs.pesu", icon: "email" },
  { name: "WhatsApp", href: "https://wa.me/917349089681", icon: "whatsapp" },
  { name: "Discord", href: "https://discord.com/invite/7kpmFp2uuU", icon: "discord" },
];
---

<footer class="event-footer relative isolate overflow-hidden bg-[#06110d] px-5 py-16 text-white sm:py-20">
  <div class="footer-matrix" aria-hidden="true">
    <img src="/footer-matrix.png" alt="" loading="lazy" />
    <div class="footer-matrix-shade"></div>
  </div>

  <div class="relative mx-auto flex max-w-5xl flex-col items-center text-center">
    <nav aria-label="Social links" class="mb-10 flex w-full flex-wrap items-center justify-center gap-3 sm:gap-14">
      {socials.map((social) => (
        <a
          class="social-link"
          href={social.href}
          aria-label={social.name}
          title={social.name}
          target={social.icon === "email" ? undefined : "_blank"}
          rel={social.icon === "email" ? undefined : "noreferrer"}
        >
          {social.icon === "instagram" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8 fill-none stroke-current" stroke-width="1.8">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r=".8" class="fill-current stroke-none" />
            </svg>
          )}
          {social.icon === "linkedin" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8 fill-current">
              <path d="M5.2 8.7H2.1V22h3.1V8.7ZM3.65 2A1.82 1.82 0 1 0 3.7 5.64 1.82 1.82 0 0 0 3.65 2ZM22 14.37c0-4-2.13-5.87-4.98-5.87a4.3 4.3 0 0 0-3.86 2.12V8.7h-3.1V22h3.1v-7.3c0-1.92.36-3.78 2.75-3.78 2.36 0 2.39 2.2 2.39 3.9V22H22v-7.63Z" />
            </svg>
          )}
          {social.icon === "email" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8 fill-current">
              <path d="M2.5 5.5h19v13h-19v-13Zm1.4 1.4 8.1 6.3 8.1-6.3H3.9Zm16.2 10.2v-8l-8.1 6.3-8.1-6.3v8h16.2Z" />
            </svg>
          )}
          {social.icon === "whatsapp" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8 fill-none stroke-current" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2.5" y="2.5" width="19" height="19" rx="4" />
              <path d="M7.2 18.1 5.8 19l.5-2.1A7 7 0 1 1 7.2 18.1Z" />
              <path d="M9.2 8.4c.3-.5.7-.4.9-.1l.8 1.4c.1.3 0 .5-.3.8l-.5.5c.6 1.2 1.4 2 2.7 2.6l.5-.6c.2-.2.5-.3.8-.1l1.3.8c.3.2.4.5.2.8-.4.8-1.2 1.2-2 1-2.7-.6-5.4-3.1-5.8-5.7-.1-.6.4-1.2 1.4-1.4Z" />
            </svg>
          )}
          {social.icon === "discord" && (
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8 fill-current">
              <path d="M19.7 5.1a18 18 0 0 0-4.4-1.4l-.6 1.2a16.4 16.4 0 0 0-5.4 0l-.6-1.2a18 18 0 0 0-4.4 1.4C1.5 9.2.7 13.2 1.1 17.1a18 18 0 0 0 5.4 2.7l1.2-2a11 11 0 0 1-1.8-.9l.4-.3a12.8 12.8 0 0 0 11.4 0l.4.3a11 11 0 0 1-1.8.9l1.2 2a18 18 0 0 0 5.4-2.7c.5-4.5-.8-8.5-3.2-12Zm-10 9.6c-.9 0-1.6-.8-1.6-1.8s.7-1.8 1.6-1.8 1.6.8 1.6 1.8-.7 1.8-1.6 1.8Zm4.6 0c-.9 0-1.6-.8-1.6-1.8s.7-1.8 1.6-1.8 1.6.8 1.6 1.8-.7 1.8-1.6 1.8Z" />
            </svg>
          )}
        </a>
      ))}
    </nav>

    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-300">Confluence · 2026</p>
    <h2 class="mt-4 text-3xl font-black tracking-tight text-white sm:text-5xl">Don’t Miss Out</h2>
    <p class="mt-3 text-sm text-gray-400 sm:text-base">Ideas become impact. Be part of the day.</p>

    <p class="event-date mt-7">
      <span class="event-dot" aria-hidden="true"></span>
      October 25, 2026
    </p>

    <div class="mt-14 flex w-full flex-col items-center justify-between gap-3 border-t border-emerald-100/10 pt-5 text-xs text-gray-500 sm:flex-row">
      <a href="#home" class="font-bold tracking-[0.18em] text-gray-300 transition hover:text-emerald-300">CONFLUENCE</a>
      <p>© {year} IEEE Computer Society PESU. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .event-footer { border-top: 0; }

  .footer-matrix {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: #06110d;
  }

  .footer-matrix img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 44%;
    opacity: 0.34;
    filter: saturate(0.85) brightness(0.78);
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
  }

  .footer-matrix-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(6 17 13 / 0.08), rgb(3 8 6 / 0.68)), linear-gradient(90deg, rgb(3 8 6 / 0.62), rgb(3 8 6 / 0.42) 50%, rgb(3 8 6 / 0.62));
  }

  .social-link {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    color: #d1fae5;
    transition: color 180ms ease, transform 180ms ease, filter 180ms ease;
  }

  .social-link:hover {
    color: #6ee7b7;
    filter: drop-shadow(0 0 9px rgb(52 211 153 / 0.55));
    transform: translateY(-3px);
  }

  .social-link:focus-visible {
    border-radius: 0.5rem;
    outline: 2px solid #6ee7b7;
    outline-offset: 5px;
  }

  .event-date {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid rgb(110 231 183 / 0.6);
    border-radius: 0.5rem;
    background: rgb(6 35 25 / 0.75);
    padding: 0.8rem 1.2rem;
    color: #d1fae5;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .event-dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #6ee7b7; box-shadow: 0 0 10px #34d399; }


  @media (prefers-reduced-motion: reduce) {
    .social-link, .event-date { transition: none; }
  }
</style>


