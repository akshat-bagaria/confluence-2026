---
const tracks = [
  {
    title: "LOSSLESS",
    description: "Make existing applications, file formats, and software built for different environments or hardware work together.",
    rules: ["The bridge must work end to end between two systems.", "Pass a round-trip test on at least five sample files without data loss."],
  },
  {
    title: "Autopsy",
    description: "Test an existing system for vulnerabilities, bugs, and errors, then find and fix their root causes.",
    rules: ["Find and fix at least three vulnerabilities. Document each root cause and retest to prove the fix.", "Only test practice apps or systems you own or have permission to test."],
  },
  {
    title: "Featherlight",
    description: "Make existing software measurably faster by improving responsiveness and reducing memory, storage, or network use.",
    rules: ["Show baseline and final benchmarks with at least a 30% improvement in one metric.", "The output must remain identical."],
  },
  {
    title: "Need-To-Know-Basis",
    description: "Improve how existing software collects, stores, and shares personal data, protecting privacy without reducing functionality.",
    rules: ["Show a before-and-after comparison of data collected or permissions.", "Prove every original feature still works."],
  },
  {
    title: "Resurrections",
    description: "Modernise legacy software, such as old code, an outdated stack, or a dated interface, without breaking what it does.",
    rules: ["Prove the new version behaves like the original with tests or recordings covering at least five scenarios."],
  },
  {
    title: "Hands-off",
    description: "Upgrade existing desktop or mobile software so people with visual or motor disabilities can use it with a screen reader, keyboard only, or touch-free controls.",
    rules: ["Fix at least three accessibility barriers, show before-and-after results with an accessibility tool, and complete a full task live."],
  },
  {
    title: "CrossBreed",
    description: "Combine two existing technologies from different domains into one product that does something neither could do alone.",
    rules: ["Name both technologies and show why combining them is useful.", "The product must stop working if either technology is removed."],
  },
];

const railTracks = [...tracks, ...tracks];
const reverseRailTracks = [...tracks].reverse();
const reverseRailLoop = [...reverseRailTracks, ...reverseRailTracks];
---

<section id="tracks" data-tracks={JSON.stringify(tracks)} class="tracks-section relative isolate overflow-hidden bg-[#06110d] px-5 py-24 sm:px-8 lg:px-12">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(16,185,129,0.13),transparent_58%)]"></div>

  <header class="mx-auto mb-12 max-w-2xl text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-emerald-300">Pick your frontier</p>
    <h2 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-6xl">Tracks</h2>
    <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-gray-300 sm:text-base">
      Seven challenge areas. One idea your team can take somewhere unexpected.
    </p>
  </header>

  <div class="mx-auto grid max-w-7xl items-center gap-8 xl:grid-cols-[minmax(210px,1fr)_minmax(420px,1.5fr)_minmax(210px,1fr)]">
    <!-- Mobile picker: stays still and wraps so every track remains easy to select. -->
    <nav class="flex flex-wrap justify-center gap-2 xl:hidden" aria-label="Choose a track">
      {tracks.map((track, index) => (
        <button type="button" class="track-chip" data-track-index={index} aria-pressed={index === 0}>
          <span class="mr-2 text-emerald-300">{String(index + 1).padStart(2, "0")}</span>{track.title}
        </button>
      ))}
    </nav>

    <!-- Opposing vertical track streams on wide screens. -->
    <aside class="track-rail hidden xl:block" aria-label="Tracks, moving upward">
      <div class="track-marquee">
        {railTracks.map((track, index) => {
          const trackIndex = index % tracks.length;
          return (
            <button type="button" class="track-chip track-rail-chip" data-track-index={trackIndex} aria-pressed={trackIndex === 0}>
              <span class="block text-xs font-semibold tracking-widest text-emerald-300">{String(trackIndex + 1).padStart(2, "0")}</span>
              <span class="mt-2 block">{track.title}</span>
            </button>
          );
        })}
      </div>
    </aside>

    <article class="track-feature" aria-live="polite" aria-atomic="true">
      <div class="flex items-center justify-between gap-4">
        <span class="track-kicker">Featured challenge</span>
        <span class="track-index"><span data-active-number>01</span><span class="text-emerald-900"> / {String(tracks.length).padStart(2, "0")}</span></span>
      </div>
      <h3 class="mt-7 text-3xl font-bold leading-tight text-white sm:text-4xl" data-active-title>
        {tracks[0].title}
      </h3>
      <p class="mt-5 leading-7 text-gray-300" data-active-description>{tracks[0].description}</p>
      <div class="mt-8 border-t border-emerald-300/15 pt-6">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">Idea sparks</p>
        <ul class="mt-4 grid gap-3 sm:grid-cols-1" data-active-rules>
          {tracks[0].rules.map((rule) => <li class="track-rule">{rule}</li>)}
        </ul>
      </div>
      <p class="mt-8 text-xs text-gray-500">Select any track around the panel to explore it.</p>
    </article>

    <aside class="track-rail hidden xl:block" aria-label="Tracks, moving downward">
      <div class="track-marquee track-marquee-reverse">
        {reverseRailLoop.map((track, index) => {
          const trackIndex = tracks.findIndex((item) => item.title === track.title);
          return (
            <button type="button" class="track-chip track-rail-chip" data-track-index={trackIndex} aria-pressed={trackIndex === 0}>
              <span class="block text-xs font-semibold tracking-widest text-emerald-300">{String(trackIndex + 1).padStart(2, "0")}</span>
              <span class="mt-2 block">{track.title}</span>
            </button>
          );
        })}
      </div>
    </aside>
  </div>

  <p class="mt-10 text-center text-xs text-gray-500">These are starting points. Follow the problem your team is excited to solve.</p>
</section>

<script>
  const section = document.querySelector<HTMLElement>("#tracks");

  if (section) {
    const trackData = JSON.parse(section.dataset.tracks ?? "[]") as Array<{
      title: string;
      description: string;
      rules: string[];
    }>;

    section.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-track-index]");
      if (!button || !section.contains(button)) return;

      const index = Number(button.dataset.trackIndex);
      const track = trackData[index];
      if (!track) return;

      const title = section.querySelector<HTMLElement>("[data-active-title]");
      const description = section.querySelector<HTMLElement>("[data-active-description]");
      const number = section.querySelector<HTMLElement>("[data-active-number]");
      const rules = section.querySelector<HTMLUListElement>("[data-active-rules]");

      if (title) title.textContent = track.title;
      if (description) description.textContent = track.description;
      if (number) number.textContent = String(index + 1).padStart(2, "0");
      if (rules) {
        rules.replaceChildren(...track.rules.map((text) => {
          const item = document.createElement("li");
          item.className = "track-rule";
          item.textContent = text;
          return item;
        }));
      }

      section.querySelectorAll<HTMLButtonElement>("button[data-track-index]").forEach((chip) => {
        const active = Number(chip.dataset.trackIndex) === index;
        chip.setAttribute("aria-pressed", String(active));
        chip.classList.toggle("is-active", active);
      });
    });
  }
</script>

<style>
  .track-rail {
    position: relative;
    height: 34rem;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }

  .track-marquee {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    animation: track-scroll 48s linear infinite;
  }

  .track-marquee-reverse { animation-direction: reverse; animation-duration: 56s; }
  .track-rail:hover .track-marquee, .track-rail:focus-within .track-marquee { animation-play-state: paused; }

  @keyframes track-scroll { to { transform: translateY(-50%); } }

  .track-chip {
    max-width: 100%;
    min-height: 2.75rem;
    padding: 0.7rem 0.9rem;
    overflow-wrap: anywhere;
    line-height: 1.35;
    border: 1px solid rgb(52 211 153 / 0.22);
    border-radius: 0.9rem;
    background: rgb(6 28 21 / 0.84);
    color: #d1fae5;
    text-align: left;
    transition: border-color 200ms ease, background 200ms ease, box-shadow 200ms ease, transform 200ms ease;
    cursor: pointer;
  }

  .track-chip:hover, .track-chip:focus-visible, .track-chip.is-active {
    border-color: rgb(110 231 183 / 0.82);
    background: rgb(8 48 34 / 0.96);
    box-shadow: 0 0 24px rgb(16 185 129 / 0.16);
    outline: none;
  }

  .track-chip:focus-visible { outline: 2px solid #6ee7b7; outline-offset: 3px; }
  .track-rail-chip { width: 100%; min-height: 6.5rem; padding: 1rem; }

  .track-feature {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(52 211 153 / 0.5);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, rgb(8 35 26 / 0.96), rgb(3 15 12 / 0.98));
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 0 50px rgb(16 185 129 / 0.1), inset 0 1px rgb(167 243 208 / 0.08);
  }

  .track-kicker { color: #6ee7b7; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }
  .track-index { color: #d1fae5; font-family: ui-monospace, monospace; font-size: 0.8rem; }
  .track-rule { border-left: 2px solid rgb(52 211 153 / 0.6); padding: 0.2rem 0 0.2rem 0.8rem; color: #d1d5db; font-size: 0.9rem; }

  @media (prefers-reduced-motion: reduce) {
    .track-marquee { animation: none; }
    .track-chip { transition: none; }
  }
</style>
